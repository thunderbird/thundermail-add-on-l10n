## Manifest

# Add-on name in the Add-ons Manager and the app menu.
addon-thunderbird-pro = { -thundermail-brand }
# Add-on description in the Add-ons Manager.
addon-extension-description = { -thundermail-brand } vous offre une adresse électronique, la planification de rendez-vous et la possibilité d’envoyer des fichiers volumineux avec un chiffrement de bout en bout.
# Name of the cloud file provider in Composition > Attachments settings.
addon-thunderbird-send = { -send-brand }

## App menu

# Label of the menu entry that signs the user in; the product name follows it.
addon-menu-sign-in-to = Se connecter à
# Menu entry that signs the user out.
addon-menu-sign-out = Déconnexion
# Tooltip of the menu entry while the user is signed in.
addon-menu-signed-in-tooltip = Connecté à { -thundermail-brand }
# Menu entry that opens the account dashboard in a tab.
addon-menu-manage-dashboard = Tableau de bord du compte
# Menu entry that opens the Send file manager in a tab.
addon-menu-manage-send = Gérer les fichiers Send
# Menu entry that opens Appointment in a tab.
addon-menu-open-appointment = Ouvrir Appointment
# Label of the back button in the signed-in submenu, used only when Thunderbird
# provides no back label of its own.
addon-menu-back = Retour

## Page titles

# Window title of the upload popup.
addon-popup-title = Envoyer avec { -send-brand }
# Tab title of the add-on management page.
addon-management-title = Module TB Pro
